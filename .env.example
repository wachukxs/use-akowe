# Database
MONGODB_URI=mongodb://localhost:27017/akowe

# Auth
NEXTAUTH_SECRET=replace_with_a_secure_random_secret
NEXTAUTH_URL=http://localhost:3000

# AI Providers
OPENAI_API_KEY=replace_with_openai_key
ANTHROPIC_API_KEY=replace_with_anthropic_key

# Search / External APIs
SERPAPI_API_KEY=replace_with_serpapi_key

# Optional: OCR fallback for scanned/image-only PDFs
# Endpoint must accept multipart/form-data with:
# - file: PDF binary
# - filename: original file name
# and return JSON: { "text": "..." }
OCR_FALLBACK_ENDPOINT=https://your-ocr-service.example.com/parse

# Optional bearer token sent as:
# Authorization: Bearer <OCR_FALLBACK_TOKEN>
OCR_FALLBACK_TOKEN=replace_with_ocr_service_token
